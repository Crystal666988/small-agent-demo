# Copy to .env and fill in. The agent reads these at startup.
# Anthropic-compatible endpoint (works with the official API or a compatible proxy).

# Base URL WITHOUT the trailing /v1/messages, e.g. https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Your API key / auth token.
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxx

# Model id used for the main agent loop.
MINIAGENT_MODEL=claude-haiku-4-5-20251001

# Optional: token budget before context compression kicks in.
MINIAGENT_MAX_CONTEXT_TOKENS=8000

# Optional: hard cap on agent loop iterations per user turn.
MINIAGENT_MAX_STEPS=8
