# Copy to .env and fill in. The agent reads these at startup.
# Two providers are supported; pick one with MINIAGENT_PROVIDER.

# ---- Provider: "anthropic" (default) or "openai" (OpenAI-compatible) ----
MINIAGENT_PROVIDER=openai

# ---- Option A: OpenAI-compatible (DeepSeek / Moonshot / local vLLM ...) ----
# Base URL WITHOUT the trailing /chat/completions.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# For DeepSeek use deepseek-chat (set via MINIAGENT_MODEL below).

# ---- Option B: Anthropic (official API or a compatible proxy) ----
# Base URL WITHOUT the trailing /v1/messages, e.g. https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxx

# Model id used for the main agent loop.
# DeepSeek: deepseek-chat   |   Anthropic: claude-haiku-4-5-20251001
MINIAGENT_MODEL=deepseek-chat

# Optional: token budget before context compression kicks in.
MINIAGENT_MAX_CONTEXT_TOKENS=8000

# Optional: hard cap on agent loop iterations per user turn.
MINIAGENT_MAX_STEPS=8
